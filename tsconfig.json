{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2021.String"
    ],
    "ignoreDeprecations": "6.0",
    "types": [
      "node",
      "obsidian"
    ]
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts"
  ]
}
